rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function activeSelf(uid) { return signedIn() && request.auth.uid == uid && get(/databases/$(database)/documents/users/$(uid)).data.status == 'ativo'; }
    match /accessRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','whatsapp','status','createdAt','requestId'])
        && request.resource.data.status == 'pendente' && request.resource.data.name is string
        && request.resource.data.email is string && request.resource.data.whatsapp is string;
      allow read, update, delete: if admin();
    }
    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if admin();
      match /app/{document=**} {
        allow read, write: if activeSelf(uid);
      }
    }
  }
}
