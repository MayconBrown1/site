rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'mayconbrown083@gmail.com'; }
    function isApproved() {
      return signedIn() && (isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    match /users/{userId} {
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        (
          (request.auth.token.email == 'mayconbrown083@gmail.com' && request.resource.data.role == 'admin' && request.resource.data.status == 'approved') ||
          (request.auth.token.email != 'mayconbrown083@gmail.com' && request.resource.data.role == 'user' && request.resource.data.status == 'pending')
        );
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoURL','updatedAt']));
      allow delete: if isAdmin();
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in ['accounts','transactions','budgets','goals','categories'] &&
        isApproved() && resource.data.userId == request.auth.uid;
      allow create: if collectionName in ['accounts','transactions','budgets','goals','categories'] &&
        isApproved() && request.resource.data.userId == request.auth.uid;
      allow update: if collectionName in ['accounts','transactions','budgets','goals','categories'] &&
        isApproved() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if collectionName in ['accounts','transactions','budgets','goals','categories'] &&
        isApproved() && resource.data.userId == request.auth.uid;
    }
  }
}
